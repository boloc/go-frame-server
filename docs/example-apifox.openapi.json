        "summary": "写入系统配置",
        "tags": [
          "系统"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "检查 default_db / config_db / redis（关键依赖）和 log_db（非关键）。关键依赖失败时 HTTP 503。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "checks": {
                    "config_db": {
                      "latency_ms": 1.4,
                      "status": "ok"
                    },
                    "default_db": {
                      "latency_ms": 1.2,
                      "status": "ok"
                    },
                    "log_db": {
                      "latency_ms": 1.1,
                      "status": "ok"
                    },
                    "redis": {
                      "latency_ms": 0.4,
                      "status": "ok"
                    }
                  },
                  "healthy": true
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "整体健康"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "checks": {
                    "config_db": {
                      "latency_ms": 1.4,
                      "status": "ok"
                    },
                    "default_db": {
                      "error": "db not initialized",
                      "latency_ms": 3.1,
                      "status": "error"
                    },
                    "log_db": {
                      "error": "db not initialized",
                      "latency_ms": 1,
                      "status": "error"
                    },
                    "redis": {
                      "latency_ms": 0.4,
                      "status": "ok"
                    }
                  },
                  "healthy": false
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "关键依赖不健康"
          }
        },
        "summary": "健康检查",
        "tags": [
          "系统"
        ]
      }
    },
