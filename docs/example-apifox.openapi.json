{
  "info": {
    "description": "cmd/example 的 HTTP 接口文档。请导入同目录的 example-apifox.openapi.json（导入 → OpenAPI/Swagger）。\n\n本文件不使用 components / $ref / 数据模型，请求和响应都按真实返回字段写成示例数据。\n\n约定：\n- 业务接口默认 HTTP 200，成功看 `code=0`，失败看 body 里的 `code` / `message` / `fields`\n- 只有明确调用 `webx.FailWithStatus` 的接口才会返回非 200 的 HTTP 状态码\n- 端口以配置 `server.port` 为准，示例配置是 `10005`\n- `/test` 下的接口需要请求头 `X-Demo-Token`（任意非空值即可，例如 `x`）\n- `POST /api/orders` 必须带 `Idempotency-Key`\n- `/api/products` 组限流：同一 IP 每分钟 10 次，超限 HTTP 429\n",
    "title": "go-frame-server example",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/cron/report-low-stock": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "message": "库存检查已执行"
                  },
                  "message": "success"
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "统一响应"
          }
        },
        "summary": "立即执行一次库存检查",
        "tags": [
          "定时任务"
        ]
      }
    },
    "/api/cron/tasks": {
      "get": {
        "description": "TaskInfo 没有 json tag，字段名是 Name / Schedule。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": [
                    {
                      "Name": "heartbeat",
                      "Schedule": "@every 30s"
                    },
                    {
                      "Name": "minute-marker",
                      "Schedule": "0 * * * * *"
                    },
                    {
                      "Name": "report-low-stock",
                      "Schedule": "0 */5 * * * *"
                    }
                  ],
                  "message": "success"
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "统一响应"
          }
        },
        "summary": "已注册定时任务列表",
        "tags": [
          "定时任务"
        ]
      }
    },
    "/api/orders": {
      "post": {
        "description": "必须带 `Idempotency-Key`。内存仓储预置数据：\n- product_id=1 有货（库存 10）\n- product_id=2 售罄\n- product_id=3 不存在\n- product_id=4 已下架，校验层直接拒绝\n- product_id=999 模拟数据库故障\n",
        "parameters": [
          {
            "example": "demo-key-1",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "product_id": 1,
                "quantity": 2
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "code": 0,
                  "data": {
                    "id": 1,
                    "product_id": 1,
                    "quantity": 2,
                    "status": "created"
                  },
                  "message": "success"
                }
              }
            },
            "description": "统一响应（默认 HTTP 200，错误看 body.code）"
          }
        },
        "summary": "创建订单",
        "tags": [
          "订单"
        ]
      }
    },
    "/api/products/list": {
      "get": {
        "description": "分页列表。`page` 默认 1，`page_size` 默认 20，最大 500。\n该组接口有限流：同一 IP 每分钟 10 次。\n",
        "parameters": [
          {
            "example": 1,
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "example": 20,
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "1=上架 0=下架，不传查全部",
            "example": 1,
            "in": "query",
            "name": "status",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "关键词，最长 50",
            "example": "导航",
            "in": "query",
            "name": "keyword",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 1,
            "in": "query",
            "name": "column_id",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "code": 0,
                  "data": {
                    "list": [
                      {
                        "column_id": 1,
                        "count": 128,
                        "cover": "https://cdn.example.com/cover.jpg",
                        "created_at": "2026-08-15 10:00:00",
                        "custom_name": "客户A",
                        "id": 1,
                        "is_skip_detail": 0,
                        "jump_url": "https://example.com/p/1",
                        "sort": 1,
                        "status": 1,
                        "status_text": "上架",
                        "tags": [
                          "热门",
                          "推荐"
                        ],
                        "title": "示例产品"
                      }
                    ],
                    "page": 1,
                    "page_size": 20,
                    "total": 1,
                    "total_pages": 1
                  },
                  "message": "success"
                }
              }
            },
            "description": "统一响应"
          },
          "429": {
            "content": {
              "application/json": {
                "example": {
                  "code": 42900,
                  "message": "请求过于频繁，请稍后重试"
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "触发限流",
            "headers": {
              "Retry-After": {
                "example": "60",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Limit": {
                "example": "10",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Remaining": {
                "example": "0",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "产品列表",
        "tags": [
          "产品"
        ]
      }
    },
    "/api/products/options": {
      "get": {
        "responses": {
          "200": {
            "content": {
